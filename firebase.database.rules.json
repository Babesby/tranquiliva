{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "profile": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "role": {
          ".write": false
        }
      }
    },
    "userData": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "therapistApplications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (!data.exists() || data.child('status').val() === 'pending') && newData.child('status').val() === 'pending'",
        ".validate": "newData.hasChildren(['email', 'status', 'submittedAt'])"
      }
    }
  }
}
