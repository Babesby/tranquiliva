# Public Firebase web configuration. Add these to Vercel for Production,
# Preview and Development. These values are safe to expose to the browser;
# Firebase Security Rules protect the data.
NEXT_PUBLIC_FIREBASE_WEB_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Public application URLs
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com

# Server-only values belong in Vercel environment variables or the API host.
# Never prefix these with NEXT_PUBLIC_ and never commit their real values.
FIREBASE_CREDENTIALS_JSON=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_FREE_DAILY_LIMIT=10
AI_PREMIUM_DAILY_LIMIT=100
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_MONTHLY_PLAN_CODE=
PAYSTACK_ANNUAL_PLAN_CODE=
PAYSTACK_CALLBACK_URL=https://your-domain.com/payment-success.html
PAYSTACK_CURRENCY=GHS
PAYSTACK_MONTHLY_AMOUNT=3000
PAYSTACK_ANNUAL_AMOUNT=28800
REDIS_URL=
ALLOW_INLINE_JOBS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hello@tranquiliva.com
SUPPORT_EMAIL=hello@tranquiliva.com
